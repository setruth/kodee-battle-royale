# Copy this file to .env on the server and replace both secrets.
# China deployment default. Set to an empty value to pull directly from Docker Hub.
DOCKER_HUB_PREFIX=m.daocloud.io/docker.io/library/

POSTGRES_DB=kotlin_game
POSTGRES_USER=kodee
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=15432

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_character_hex_secret

FRONTEND_PORT=18080
WEBRTC_MIN_PORT=50000
WEBRTC_MAX_PORT=50100
# Optional. The previous project default was stun:159.75.28.209:53478.
WEBRTC_STUN_URL=
