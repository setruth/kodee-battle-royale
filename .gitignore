# ==========================================
# Root Git Ignore Configuration
# ==========================================

# Design documentation folder (Not to be pushed)
design/

# Server runtime configuration (tracked: application.default.yaml, ignored: application.yaml)
server/src/main/resources/application.yaml
!server/src/main/resources/application.default.yaml

# Node & Frontend dependencies and build output
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
dist.zip
web/dist.zip
*.local
.env.development.local
.env.production
.env.production.*
.env.local
web/.env.production
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tsconfig.tsbuildinfo

# Gradle & Kotlin / Java build output
.gradle/
**/build/
.kotlin/
bin/
out/
*.class
*.jar
*.war

# IDE & Editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
